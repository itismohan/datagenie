# Copy to .env and replace every placeholder before starting the platform.
DATAGENIE_ENVIRONMENT=development
DATAGENIE_LOG_LEVEL=INFO
DATAGENIE_AUTH_ENABLED=true
DATAGENIE_AUTH_JWT_SECRET=replace-with-a-unique-32-character-minimum-local-secret

DATAGENIE_POSTGRES_DB=datagenie
DATAGENIE_POSTGRES_USER=datagenie
DATAGENIE_POSTGRES_PASSWORD=replace-with-a-local-database-password
DATAGENIE_NEO4J_PASSWORD=replace-with-a-local-neo4j-password

# Quality-service operation defaults
DATAGENIE_QUALITY_RECENCY_HOURS=24
DATAGENIE_QUALITY_TASK_ALWAYS_EAGER=false
