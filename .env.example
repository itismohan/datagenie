# Copy to .env and replace every placeholder before starting the platform.
DATAGENIE_ENVIRONMENT=development
DATAGENIE_LOG_LEVEL=INFO
# Replace localhost with the production DNS name before enabling public ingress.
DATAGENIE_PUBLIC_HOSTNAME=localhost
DATAGENIE_TLS_EMAIL=ops@example.com
DATAGENIE_AUTH_ENABLED=true
DATAGENIE_AUTH_JWT_SECRET=replace-with-a-unique-32-character-minimum-local-secret
# Shared deployments require this claim on every OIDC or JWT access token.
DATAGENIE_AUTH_TENANT_CLAIM=tenant_id
DATAGENIE_TENANT_ISOLATION_ENABLED=true
DATAGENIE_TENANT_DEFAULT_ID=default

# API abuse protection. Production requires this to be enabled with a Redis URL.
DATAGENIE_RATE_LIMIT_ENABLED=true
DATAGENIE_RATE_LIMIT_REDIS_URL=redis://redis:6379/1
DATAGENIE_RATE_LIMIT_REQUESTS=300
DATAGENIE_RATE_LIMIT_WINDOW_SECONDS=60
DATAGENIE_RATE_LIMIT_FAIL_OPEN=false

# Durable connector job queue and result backend.
DATAGENIE_CONNECTOR_REDIS_URL=redis://redis:6379/2
DATAGENIE_CONNECTOR_TASK_TIME_LIMIT_SECONDS=1800
DATAGENIE_CONNECTOR_TASK_SOFT_TIME_LIMIT_SECONDS=1740
DATAGENIE_CONNECTOR_MAX_RETRIES=3
DATAGENIE_CONNECTOR_RETRY_BACKOFF_SECONDS=30
DATAGENIE_CONNECTOR_LEASE_SECONDS=1860

# Production exception tracking. Replace with the organization-managed DSN.
DATAGENIE_ERROR_TRACKING_DSN=
DATAGENIE_ERROR_TRACKING_TRACES_SAMPLE_RATE=0.1

# Comma-separated, tenant-approved outbound webhook hostnames. Do not include private network addresses.
DATAGENIE_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
DATAGENIE_WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
DATAGENIE_WEBHOOK_MAX_RETRIES=5

DATAGENIE_POSTGRES_DB=datagenie
DATAGENIE_POSTGRES_USER=datagenie
DATAGENIE_POSTGRES_PASSWORD=replace-with-a-local-database-password
DATAGENIE_NEO4J_PASSWORD=replace-with-a-local-neo4j-password

# Quality-service operation defaults
DATAGENIE_QUALITY_RECENCY_HOURS=24
DATAGENIE_QUALITY_TASK_ALWAYS_EAGER=false
