# Copy to a protected staging-only secret store or environment file.
# This profile permits exactly one named internal tenant and one approved MCP host.
# Do not commit live issuer URLs, credentials, tenant names, host IDs, or service secrets.

DATAGENIE_ENVIRONMENT=staging
DATAGENIE_MCP_INTERNAL_BETA_ENABLED=true
DATAGENIE_MCP_KILL_SWITCH_ENABLED=false
DATAGENIE_MCP_DISABLED_TOOLS=
DATAGENIE_MCP_ALLOWED_TENANTS=replace-with-one-non-customer-internal-tenant
DATAGENIE_MCP_ALLOWED_HOSTS=replace-with-one-approved-internal-mcp-host
DATAGENIE_MCP_ALLOWED_ORIGINS=https://replace-with-approved-internal-host.example.com
DATAGENIE_MCP_REQUIRED_AUDIENCE=datagenie-mcp
DATAGENIE_MCP_RESOURCE_BASE_URL=https://replace-with-internal-mcp-host.example.com/mcp
DATAGENIE_MCP_AUTHORIZATION_SERVERS=https://replace-with-authority.example.com

# OIDC resource-server validation for the MCP gateway.
DATAGENIE_AUTH_ENABLED=true
DATAGENIE_AUTH_MODE=oidc
DATAGENIE_AUTH_OIDC_ISSUER=https://replace-with-authority.example.com
DATAGENIE_AUTH_OIDC_AUDIENCE=replace-with-gateway-oidc-audience
DATAGENIE_AUTH_OIDC_JWKS_URL=https://replace-with-authority.example.com/.well-known/jwks.json
DATAGENIE_AUTH_OIDC_ROLE_CLAIM=roles
DATAGENIE_AUTH_TENANT_CLAIM=tenant_id
DATAGENIE_AUTH_SCOPE_CLAIM=scope

# Use a secret-manager injection. This exact same secret must be supplied to
# catalog, quality, lineage, and MCP gateway containers for signed delegation.
DATAGENIE_MCP_GATEWAY_SERVICE_SHARED_SECRET=inject-from-secret-manager
DATAGENIE_MCP_GATEWAY_SERVICE_IDENTITY_ENABLED=true
DATAGENIE_MCP_GATEWAY_SERVICE_ID=mcp-gateway
DATAGENIE_MCP_GATEWAY_SERVICE_MAX_SKEW_SECONDS=60

# Start conservatively; change only with product, security, and operations approval.
DATAGENIE_MCP_MAX_REQUESTS_PER_MINUTE=20
DATAGENIE_MCP_MAX_RESULTS=10
DATAGENIE_MCP_MAX_LINEAGE_DEPTH=2
DATAGENIE_MCP_MAX_LINEAGE_NODES=50
DATAGENIE_MCP_TOOL_TIMEOUT_SECONDS=5

# The MCP execution ledger is durable and must target staging PostgreSQL.
DATAGENIE_LEDGER_DATABASE_URL=postgresql+psycopg://replace-with-secret-managed-postgres-url
